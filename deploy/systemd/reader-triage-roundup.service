[Unit]
Description=Reader Triage - Send weekly Telegram roundup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/evan/dev/inbox_monitor
Environment=PATH=/home/evan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/evan/.local/bin/uv run python -m tools.send_digest weekly
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reader-triage-roundup
