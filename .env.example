# Required
READWISE_TOKEN=<your Readwise Reader access token>
ANTHROPIC_API_KEY=<your Anthropic API key>

# Optional
DATABASE_URL=sqlite+aiosqlite:///./reader_triage.db
ROOT_PATH=
OTLP_ENDPOINT=http://localhost:4317

# ntfy fallback for digest delivery (used when nanobot fails)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# LLM gateway (LiteLLM): set both to route scoring/tagging/summarization/chat
# through the local gateway for spend attribution; leave unset for direct.
LLM_GATEWAY_BASE_URL=http://localhost:18400/v1
LLM_GATEWAY_API_KEY=GATEWAY_KEY_PLACEHOLDER

# Model selection. When the gateway is configured above, use its tier
# aliases instead of concrete provider model ids:
#   - litellm/dspy clients (SCORING_MODEL, TAGGER_MODEL) need the
#     "openai/"-prefixed mirror, e.g. openai/tier-nano, openai/tier-fast,
#     openai/tier-smart, openai/tier-deep.
#   - Anthropic-SDK clients (CHAT_MODEL) use the bare alias, e.g. tier-smart.
SCORING_MODEL=openai/tier-fast
TAGGER_MODEL=openai/tier-nano
CHAT_MODEL=tier-smart
